{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LavO Gaming Hub",
  "version": "1.2.1",
  "identifier": "com.lavo.gaminghub",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "title": "LavO Gaming Hub",
        "width": 1280,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0e0e0f"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}